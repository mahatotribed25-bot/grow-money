rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email != null && 
             (request.auth.token.email.lower() == "admin@tribed.world" || 
              request.auth.token.email.lower() == "admin@tribed.com");
    }

    function isSubAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'subadmin';
    }
    
    function isManager() {
      return isAdmin() || isSubAdmin();
    }

    // Rules for 'users'
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isAuthenticated();
      allow update: if isAuthenticated(); // Allow self-updates and cross-updates for referrals
      allow delete: if isAdmin();

      match /investments/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isOwner(userId) || isManager();
      }
      match /loans/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isOwner(userId) || isManager();
      }
      match /walletHistory/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isAuthenticated(); // Needed for referral bonus credits
      }
    }

    // Investment Plans
    match /investmentPlans/{planId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated(); // For decrementing stock during purchase
      allow write: if isManager();
    }
    
    // Announcements
    match /announcements/{id} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Tasks rules
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated(); // To decrement remaining stock
      allow write: if isManager();
    }

    // Task Submissions rules
    match /taskSubmissions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if isAuthenticated();
      allow update, delete: if isManager();
    }

    // Deposits
    match /deposits/{id} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow update, delete: if isManager();
    }

    // Withdrawals
    match /withdrawals/{id} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow update, delete: if isManager();
    }

    // scratchCards rules
    match /scratchCards/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if isManager();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow delete: if isManager();
    }

    // Global Settings
    match /settings/{id} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated(); // For syncing adminProfitBalance during purchase
      allow write: if isManager();
    }

    // Custom Loan Requests rules
    match /customLoanRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if isAuthenticated();
      allow update: if isManager() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isManager();
    }

    // UPI Requests
    match /upiRequests/{requestId} {
       allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
       allow create: if isAuthenticated();
       allow update: if isManager() || (isAuthenticated() && resource.data.userId == request.auth.uid);
       allow delete: if isManager();
    }

    // Coupons rules
    match /coupons/{couponId} {
      allow read, update: if isAuthenticated();
      allow write: if isManager();
    }

    // User Private Chat Sessions
    match /userChatSessions/{id} {
        allow read, write: if isAuthenticated() && (request.auth.uid in resource.data.participants || isManager());
        match /messages/{mid} {
            allow read, write: if isAuthenticated();
        }
    }

    // Support Chat Sessions
    match /chats/{id} {
        allow read, write: if isAuthenticated() && (id == request.auth.uid || isManager());
        match /messages/{mid} {
            allow read, write: if isAuthenticated();
        }
    }

    // P2P Marketplace rules
    match /p2pLoanRequests/{id} {
        allow read, create: if isAuthenticated();
        allow update: if isAuthenticated(); // For making bids
        allow delete: if isManager() || (isAuthenticated() && resource.data.borrowerId == request.auth.uid);
        match /offers/{oid} {
            allow read, write: if isAuthenticated();
        }
    }
    
    match /p2pActiveLoans/{id} {
        allow read: if isAuthenticated() && (resource.data.borrowerId == request.auth.uid || resource.data.lenderId == request.auth.uid || isManager());
        allow write: if isAuthenticated(); // Matching transaction needs this
    }

    // COLLECTION GROUP RULES for investments
    match /{path=**}/investments/{id} {
      allow read: if isManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.investorId == request.auth.uid));
    }

    // Generic match for other collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}