rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email != null && 
             (request.auth.token.email.lower() == "admin@tribed.world" || 
              request.auth.token.email.lower() == "admin@tribed.com");
    }

    function isSubAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'subadmin';
    }
    
    function isManager() {
      return isAdmin() || isSubAdmin();
    }

    // Rules for 'users'
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isAuthenticated();
      // Allow self-updates and cross-updates for referral bonus processing during transactions
      allow update: if isAuthenticated(); 

      match /investments/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isOwner(userId) || isManager();
      }
      match /loans/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isOwner(userId) || isManager();
      }
      match /walletHistory/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isAuthenticated();
      }
    }

    // Investment Plans - Allow authenticated users to update stock during purchase
    match /investmentPlans/{planId} {
      allow read: if isAuthenticated();
      allow update, write: if isAuthenticated(); 
    }
    
    // Announcements
    match /announcements/{id} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Deposits
    match /deposits/{id} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow update, delete: if isManager();
    }

    // Withdrawals
    match /withdrawals/{id} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow update, delete: if isManager();
    }

    // scratchCards rules
    match /scratchCards/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if isManager();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow delete: if isManager();
    }

    // Global Settings - Allow authenticated users to update profit balance during purchase
    match /settings/{id} {
      allow read: if isAuthenticated();
      allow update, write: if isAuthenticated(); 
    }

    // Custom Loan Requests rules - Allow users to accept offers and mark payments
    match /customLoanRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if isAuthenticated();
      // Crucial: Allow users to update status for Accept and Settle actions
      allow update: if isManager() || (isAuthenticated() && request.auth.uid == resource.data.userId);
      allow delete: if isManager();
    }

    // UPI Requests
    match /upiRequests/{requestId} {
       allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
       allow create: if isAuthenticated();
       allow update: if isManager() || (isAuthenticated() && resource.data.userId == request.auth.uid);
       allow delete: if isManager();
    }

    // Coupons rules
    match /coupons/{couponId} {
      allow read, update: if isAuthenticated();
      allow write: if isManager();
    }

    // Support Chat Sessions
    match /chats/{id} {
        allow read, write: if isAuthenticated() && (id == request.auth.uid || isManager());
        match /messages/{mid} {
            allow read, write: if isAuthenticated();
        }
    }

    // Group Loan Plans
    match /groupLoanPlans/{planId} {
      allow read: if isAuthenticated();
      allow update, write: if isAuthenticated();
      
      match /investments/{invId} {
        allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
        allow write: if isAuthenticated();
      }
      match /repayments/{repId} {
        allow read: if isAuthenticated();
        allow write: if isManager();
      }
      match /payouts/{payId} {
        allow read: if isAuthenticated() && (resource.data.investorId == request.auth.uid || isManager());
        allow write: if isManager();
      }
    }

    // Collection Group Rule for investments
    match /{path=**}/investments/{id} {
      allow read, list: if isAuthenticated();
    }

    // Generic match for other collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}