
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email != null && 
             (request.auth.token.email.lower() == "admin@tribed.world" || 
              request.auth.token.email.lower() == "admin@tribed.com");
    }

    function isSubAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'subadmin';
    }
    
    function isManager() {
      return isAdmin() || isSubAdmin();
    }

    // User collection and its subcollections
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isAuthenticated();
      // Allow update for self (profile changes) and for others (referral bonus logic)
      allow update: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }
    
    // Global settings and plans
    match /investmentPlans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Needed for stock updates
    }
    
    match /settings/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Needed for admin profit updates
    }

    match /announcements/{id} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /deposits/{id} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isManager() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /withdrawals/{id} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isManager() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /customLoanRequests/{requestId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isManager();
    }

    match /loanRequests/{requestId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isManager();
    }

    match /loanPlans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /upiRequests/{requestId} {
       allow read, create, update: if isAuthenticated();
       allow delete: if isManager();
    }

    match /chats/{id} {
        allow read, write: if isAuthenticated() && (id == request.auth.uid || isManager());
        match /messages/{mid} {
            allow read, write: if isAuthenticated();
        }
    }

    match /groupLoanPlans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
      
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /staffSalaries/{id} {
        allow read: if isAuthenticated();
        allow write: if isManager();
    }

    match /taskSubmissions/{id} {
        allow read, write: if isAuthenticated();
    }

    match /tasks/{id} {
        allow read: if isAuthenticated();
        allow write: if isManager();
    }

    match /p2pLoanRequests/{id} {
        allow read, write: if isAuthenticated();
        match /offers/{oid} {
            allow read, write: if isAuthenticated();
        }
    }

    match /p2pActiveLoans/{id} {
        allow read, write: if isAuthenticated();
    }

    match /adminWithdrawals/{id} {
        allow read, write: if isManager();
    }

    match /coupons/{id} {
        allow read: if isAuthenticated();
        allow write: if isManager();
    }

    match /scratchCards/{id} {
        allow read, write: if isAuthenticated();
    }

    match /userChatSessions/{id} {
        allow read, write: if isAuthenticated();
        match /messages/{mid} {
            allow read, write: if isAuthenticated();
        }
    }
  }
}
