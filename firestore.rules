
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email != null && 
             (request.auth.token.email.lower() == "admin@tribed.world" || 
              request.auth.token.email.lower() == "admin@tribed.com");
    }

    function isSubAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'subadmin';
    }
    
    function isManager() {
      return isAdmin() || isSubAdmin();
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isAuthenticated();
      allow update: if isAuthenticated(); 

      match /investments/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isOwner(userId) || isManager();
      }
      match /loans/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isOwner(userId) || isManager();
        allow update: if isOwner(userId) || isManager();
      }
      match /walletHistory/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isAuthenticated();
      }
    }
    
    match /attendance/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /investmentPlans/{planId} {
      allow read: if isAuthenticated();
      allow update, write: if isAuthenticated(); 
    }
    
    match /announcements/{id} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /deposits/{id} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow update, delete: if isManager();
    }

    match /withdrawals/{id} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow update, delete: if isManager();
    }

    match /settings/{id} {
      allow read: if isAuthenticated();
      allow update, write: if isAuthenticated(); 
    }

    match /customLoanRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if isAuthenticated();
      allow update: if isManager() || (isAuthenticated() && request.auth.uid == resource.data.userId);
      allow delete: if isManager();
    }

    match /upiRequests/{requestId} {
       allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
       allow create: if isAuthenticated();
       allow update: if isManager() || (isAuthenticated() && resource.data.userId == request.auth.uid);
       allow delete: if isManager();
    }

    match /chats/{id} {
        allow read, write: if isAuthenticated() && (id == request.auth.uid || isManager());
        match /messages/{mid} {
            allow read, write: if isAuthenticated();
        }
    }

    match /groupLoanPlans/{planId} {
      allow read: if isAuthenticated();
      allow update, write: if isAuthenticated();
      
      match /investments/{invId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    match /staffSalaries/{id} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
    }

    match /{path=**}/investments/{id} {
      allow read, list: if isAuthenticated();
    }
  }
}
