rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email != null && 
             (request.auth.token.email.lower() == "admin@tribed.world" || 
              request.auth.token.email.lower() == "admin@tribed.com");
    }

    function isSubAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'subadmin';
    }
    
    function isManager() {
      return isAdmin() || isSubAdmin();
    }

    // Investment Plans - All can read, users update stock during transaction
    match /investmentPlans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Allow users to decrement stock during investment
    }
    
    // Announcements
    match /announcements/{id} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Tasks rules
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Task Submissions rules
    match /taskSubmissions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if isAuthenticated();
      allow update, delete: if isManager();
    }

    // Deposits
    match /deposits/{id} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow update, delete: if isManager();
    }

    // Withdrawals
    match /withdrawals/{id} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow update, delete: if isManager();
    }

    // scratchCards rules
    match /scratchCards/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if isManager();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow delete: if isManager();
    }

    // Global Settings (e.g., admin profit sync)
    match /settings/{id} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated(); // Needed for profit balance sync during investment
      allow write: if isManager();
    }

    // COLLECTION GROUP RULES for investments (across all users)
    match /{path=**}/investments/{id} {
      allow read: if isManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.investorId == request.auth.uid));
      allow create: if isAuthenticated();
      allow update, delete: if isManager() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Rules for 'users'
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isAuthenticated();
      // Allow authenticated to update (for referrals bonus etc in transactions)
      allow update: if isAuthenticated(); 
      allow delete: if isAdmin();

      match /investments/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isOwner(userId) || isManager();
      }
      match /loans/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isOwner(userId) || isManager();
      }
      match /walletHistory/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isAuthenticated(); // Allow adding history (referrals etc)
      }
    }

    // Custom Loan Requests rules
    match /customLoanRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow delete: if isManager();
    }

    // UPI Requests
    match /upiRequests/{requestId} {
       allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
       allow create: if isAuthenticated();
       allow update, delete: if isManager() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Coupons rules
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated(); // Allow users to update stock when redeeming
      allow write: if isManager();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}