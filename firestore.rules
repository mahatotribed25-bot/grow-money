
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email != null && 
             (request.auth.token.email.lower() == "admin@tribed.world" || 
              request.auth.token.email.lower() == "admin@tribed.com");
    }

    function isSubAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'subadmin';
    }
    
    function isManager() {
      return isAdmin() || isSubAdmin();
    }

    // Tasks rules
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Task Submissions rules
    match /taskSubmissions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if isAuthenticated();
      allow update, delete: if isManager();
    }

    // scratchCards rules
    match /scratchCards/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow create: if isManager();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow delete: if isManager();
    }

    // COLLECTION GROUP RULES
    match /{path=**}/investments/{id} {
      // Allow users to list their own investments in collection groups (like group loans)
      // For list operations, the query MUST filter by investorId or userId to match this rule
      allow list, get: if isManager() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.investorId == request.auth.uid));
      allow write: if isManager();
    }

    // Rules for 'users'
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isAuthenticated();
      allow update: if isAuthenticated(); 
      allow delete: if isAdmin();

      match /investments/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isOwner(userId) || isManager();
      }
      match /loans/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isOwner(userId) || isManager();
      }
      match /walletHistory/{id} {
        allow read: if isOwner(userId) || isManager();
        allow write: if isManager();
      }
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
