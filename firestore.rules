
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // User collection and its subcollections (investments, history, loans)
    match /users/{userId} {
      allow read: if isSignedIn();
      // Allow creation of own profile
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Allow update for any authenticated user to facilitate referral bonuses and status updates
      // The transaction requires being able to update the referrer's balance
      allow update: if isSignedIn();

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }
    
    // Investment plans - allowing write for stock updates during purchase
    match /investmentPlans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    // Global settings - allowing write for admin profit balance updates
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Announcements and news
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Deposits and Withdrawals
    match /deposits/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /withdrawals/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Standard and Custom Loans
    match /loanRequests/{requestId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /loanPlans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /customLoanRequests/{requestId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /upiRequests/{requestId} {
       allow read: if isSignedIn();
       allow write: if isSignedIn();
    }

    // Group Loan Pools
    match /groupLoanPlans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
      
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    // Staff and Payroll
    match /staffSalaries/{id} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
    }

    match /attendance/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Tasks and Marketplace
    match /tasks/{id} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
    }

    match /taskSubmissions/{id} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
    }

    match /p2pLoanRequests/{id} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
        match /{allSubcollections=**} {
            allow read, write: if isSignedIn();
        }
    }

    match /p2pActiveLoans/{id} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
    }

    // Admin Ledger
    match /adminWithdrawals/{id} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
    }

    // Incentives
    match /coupons/{id} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
    }

    match /scratchCards/{id} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
    }

    // Support and Private Communication
    match /chats/{id} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
        match /{allSubcollections=**} {
            allow read, write: if isSignedIn();
        }
    }

    match /userChatSessions/{id} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
        match /{allSubcollections=**} {
            allow read, write: if isSignedIn();
        }
    }
  }
}
