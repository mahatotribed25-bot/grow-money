
{
  "entities": {
    "user": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "subadmin"] },
        "permissions": {
            "type": "object",
            "properties": {
                "canManageDeposits": { "type": "boolean" },
                "canManageWithdrawals": { "type": "boolean" },
                "canManageKyc": { "type": "boolean" },
                "canManagePlanLoans": { "type": "boolean" },
                "canManageCustomLoans": { "type": "boolean" },
                "canManageMarket": { "type": "boolean" }
            }
        },
        "walletBalance": { "type": "number" },
        "totalInvestment": { "type": "number" },
        "totalIncome": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Blocked"] },
        "trustScore": { "type": "number" },
        "vipLevel": { "type": "string", "enum": ["Bronze", "Silver", "Gold", "Platinum"] },
        "kycStatus": { "type": "string", "enum": ["Not Submitted", "Pending", "Verified", "Rejected"] },
        "baseSalary": { "type": "number" }
      },
      "required": ["uid", "email"]
    },
    "attendance": {
      "title": "Attendance",
      "description": "Daily attendance log for staff members.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["present", "absent", "half-day", "holiday"] },
        "reason": { "type": "string" },
        "month": { "type": "string" },
        "year": { "type": "number" }
      }
    },
    "staffSalary": {
        "title": "Staff Salary",
        "description": "A record of salary payment to a staff member.",
        "type": "object",
        "properties": {
            "staffId": { "type": "string" },
            "staffName": { "type": "string" },
            "month": { "type": "string" },
            "year": { "type": "number" },
            "baseSalary": { "type": "number" },
            "bonus": { "type": "number" },
            "deductions": { "type": "number" },
            "netPaid": { "type": "number" },
            "paidAt": { "type": "string", "format": "date-time" },
            "paymentMethod": { "type": "string" },
            "transactionId": { "type": "string" }
        }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "Stores user profile information."
    },
    "/attendance/{id}": {
      "schema": { "$ref": "#/entities/attendance" },
      "description": "Daily logs for staff attendance."
    },
    "/staffSalaries/{salaryId}": {
        "schema": { "$ref": "#/entities/staffSalary" },
        "description": "Stores historical salary payment records."
    }
  }
}
